{
  "$schema": "https://app.kilo.ai/config.json",
  "auto_collapse_reasoning": false,
  "terminal_command_display": "expanded",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      // 1) Fallback first — anything unmatched prompts.
      "*": "ask",

      // 2) Read-only shell inspection.
      "cat *": "allow", "head *": "allow", "tail *": "allow", "less *": "allow",
      "ls *": "allow", "tree *": "allow", "pwd *": "allow", "echo *": "allow",
      "wc *": "allow", "which *": "allow", "type *": "allow", "file *": "allow",
      "diff *": "allow", "du *": "allow", "df *": "allow", "date *": "allow",
      "uname *": "allow", "whoami *": "allow", "printenv *": "allow",
      "grep *": "allow", "rg *": "allow", "ag *": "allow", "sort *": "allow",
      "uniq *": "allow", "cut *": "allow", "tr *": "allow", "jq *": "allow",
      "man *": "allow", "sed *": "allow", "sleep *": "allow", "find *": "allow",
      "printf *": "allow", "true *": "allow",

      // 3) PowerShell read-only cmdlets.
      "Get-ChildItem *": "allow", "Get-Content *": "allow", "Get-Location *": "allow",
      "Get-Date *": "allow", "Select-Object *": "allow", "Select-String *": "allow",
      "Where-Object *": "allow", "Measure-Object *": "allow", "Compare-Object *": "allow",
      "Format-Table *": "allow", "Format-List *": "allow", "Out-String *": "allow",
      "Split-Path *": "allow", "Join-Path *": "allow", "Test-Path *": "allow",

      // 4) git: read-only allowed; mutations (add/commit/push/checkout/...) fall through to ask.
      "git status *": "allow", "git log *": "allow", "git show *": "allow",
      "git diff *": "allow", "git blame *": "allow", "git rev-parse *": "allow",
      "git rev-list *": "allow", "git ls-files *": "allow", "git ls-tree *": "allow",
      "git ls-remote *": "allow", "git branch --list *": "allow", "git branch -a *": "allow",
      "git branch -r *": "allow", "git remote -v *": "allow", "git tag -l *": "allow",
      "git stash list *": "allow", "git shortlog *": "allow", "git describe *": "allow",
      "git cat-file *": "allow", "git name-rev *": "allow",

      // 5) gh: read-only allowed; everything else (pr create, merge, api POST...) asks.
      "gh issue view *": "allow", "gh issue list *": "allow",
      "gh pr view *": "allow", "gh pr list *": "allow", "gh pr checks *": "allow",
      "gh pr diff *": "allow", "gh repo view *": "allow",
      "gh run list *": "allow", "gh run view *": "allow", "gh status *": "allow",

      // 6) Python/dev toolchain (this user's daily work).
      "python *": "allow", "pytest *": "allow", "python -m pytest *": "allow",
      "mypy *": "allow", "ruff *": "allow", "pre-commit *": "allow",
      "pip list *": "allow", "pip show *": "allow",
      "conda list *": "allow", "conda info *": "allow", "conda env list *": "allow",
      "conda search *": "allow", "conda config --show *": "allow",

      // 7) docker: read-only only.
      "docker ps *": "allow", "docker images *": "allow", "docker logs *": "allow",
      "docker inspect *": "allow", "docker version *": "allow", "docker info *": "allow",
      "docker compose ps *": "allow", "docker compose logs *": "allow",
      "docker compose config *": "allow",

      // 8) Mutations: always prompt, even if the catch-all is relaxed later.
      "*>*": "ask",
      "conda create *": "ask", "conda env create *": "ask",
      "conda env update *": "ask", "conda install *": "ask",
      "conda remove *": "ask", "conda env remove *": "ask", "conda update *": "ask",
      "pip install *": "ask", "pip3 install *": "ask",
      "python -m pip install *": "ask", "python3 -m pip install *": "ask",
      "git commit *": "ask", "git push *": "ask", "git reset *": "ask",
      "git rebase *": "ask", "git clean *": "ask",
      "gh pr create *": "ask",

      // 9) Denies LAST so they win over any broad allow or ask above.
      "git push --force *": "deny", "git push * --force*": "deny",
      "git reset --hard *": "deny",
      "git clean -f *": "deny", "git clean -ff *": "deny", "git clean -fd *": "deny",
      "dd *": "deny",
      "shutdown *": "deny", "Restart-Computer *": "deny", "Stop-Computer *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/Users/dyeaw/.local/share/kilo/plans/*": "allow",
      "C:\\Users\\DYeaw\\Projects\\conda\\*": "allow",
      "C:\\Users\\DYeaw\\Projects\\conda\\conda\\*": "allow"
    },
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "*": "ask",
    "codesearch": "allow",
    "todowrite": "allow"
  },
  "default_agent": "plan",
  "instructions": ["~/.config/kilo/instructions/*.md"],
  "mcp": {
    "basic-memory": {
      "type": "local",
      "command": ["uvx", "--python", "3.13", "basic-memory", "mcp"],
      "enabled": true
    }
  }
}
